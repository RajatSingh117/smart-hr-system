# Security
SECRET_KEY=generate-a-strong-secret-key-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com

# Database Configuration
# In production on Render, DATABASE_URL is set automatically by the database service.
# Example: postgresql://smart_hr_user:password@dpg-xxxxxx.render.com/smart_hr_db
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Alternative discrete PostgreSQL variables (if DATABASE_URL is not used):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=smart_hr_db
# DB_USER=smart_hr_user
# DB_PASSWORD=your-secure-password
# DB_HOST=localhost
# DB_PORT=5432

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@smarthrms.local
# For SMTP production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Celery & Redis Configuration (Optional)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
